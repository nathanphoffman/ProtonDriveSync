    "lint": "biome check src"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
