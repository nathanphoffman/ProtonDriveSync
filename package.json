{
  "name": "proton-drive-sync",
  "version": "1.0.0",
  "description": "Syncs a local folder to Proton Drive using the proton-drive CLI",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
